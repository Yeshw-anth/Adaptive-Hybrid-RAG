# --- General Settings ---
APP_NAME="Auto-Adaptive RAG"
HOST="127.0.0.1"
PORT=8000
RELOAD=False

# --- Loguru Settings ---
LOG_LEVEL="INFO"

# --- RAG Pipeline Settings ---
CLEAR_ON_RESTART=False
CHUNK_SIZE=512
CHUNK_OVERLAP=50
RETRIEVER_TOP_K=10
RERANKER_TOP_N=5
FAST_PIPELINE_TOP_K=5

# --- LLM & Embedding Model Settings ---
EMBED_MODEL_NAME="BAAI/bge-small-en-v1.5"
DEFAULT_LLM_MODEL="phi3"
SMALL_LLM_MODEL="phi3"
LARGE_LLM_MODEL="phi3"
MULTIMODAL_LLM_MODEL="moondream"

# --- Vector Store & Graph Settings ---
GRAPH_STORE_TYPE="networkx"  # "networkx" or "neo4j"

# --- Neo4j Settings (Fill these in if using Neo4j) ---
NEO4J_URI="bolt://localhost:7687"
NEO4J_USER="neo4j"
NEO4J_PASSWORD="your_neo4j_password"